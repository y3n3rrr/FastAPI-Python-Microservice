APP_APP_NAME=fastapi-microservice
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_DATABASE_URL=postgresql+psycopg://postgres:12312331@localhost:5432/postgres
APP_DATABASE_SCHEMA=migros_store
APP_LOG_LEVEL=INFO
APP_JWT_SECRET_KEY=change-me
APP_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_API_REQUEST_LOGGING_ENABLED=true
APP_API_REQUEST_LOG_QUEUE_SIZE=1000
APP_API_REQUEST_LOG_BODY_MAX_LENGTH=4000
APP_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
APP_CORS_ALLOW_CREDENTIALS=true
APP_CORS_ALLOW_METHODS=*
APP_CORS_ALLOW_HEADERS=*
APP_ASSISTANT_LLM_PROVIDER=ollama
APP_ASSISTANT_OLLAMA_BASE_URL=http://127.0.0.1:11434
APP_ASSISTANT_OLLAMA_MODEL=llama3.1:8b
APP_ASSISTANT_OLLAMA_TIMEOUT_SECONDS=30
